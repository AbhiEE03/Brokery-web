PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/brokery
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password

CLIENT_URL=http://localhost:5173

# Only used by scripts/createAdmin.js and scripts/seed.js — never commit real values
ADMIN_EMAIL=admin@brokery.com
ADMIN_PASSWORD=
# Optional: override the public demo broker passwords when seeding
SEED_BROKER_PASSWORD=

# Platform
# Set to 1 when running behind one reverse proxy (Render) so rate limits see real client IPs
TRUST_PROXY=1
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=5
